{
  "name": "kfc-music-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "KFC Music — KTV 歌词字幕视频制作（Electron 前端）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.kfcmusic.app",
    "productName": "KFC Music",
    "compression": "maximum",
    "electronLanguages": ["zh-CN", "en-US"],
    "directories": {
      "output": "../dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      { "from": "../dist-resources/backend", "to": "backend" },
      { "from": "../dist-resources/bin", "to": "bin", "filter": ["**/*", "!models/**"] }
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        { "target": "dmg" }
      ]
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    }
  }
}
